<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.hopash.core-runtime</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/PrivilegedHelperTools/io.hopash.core-runtime</string>
    <string>__core-service</string>
    <string>--owner-uid</string>
    <string>@OWNER_UID@</string>
    <string>--socket</string>
    <string>/var/run/hopash-rs/core-service.sock</string>
    <string>--runtime-root</string>
    <string>/Library/Application Support/Hopash RS/runtime</string>
    <string>--mihomo</string>
    <string>/Library/Application Support/Hopash RS/bin/mihomo</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
