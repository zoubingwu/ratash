#!/bin/sh
set -eu

SERVICE_LABEL='io.ratash.core-runtime'
SERVICE_PLIST='/Library/LaunchDaemons/io.ratash.core-runtime.plist'
SERVICE_EXECUTABLE='/Library/PrivilegedHelperTools/io.ratash.core-runtime'
SERVICE_ROOT='/Library/Application Support/ratash'
GEODATA_ROOT="$SERVICE_ROOT/share/geodata"
CLI_EXECUTABLE='/usr/local/bin/ratash'
SERVICE_REMOVAL_ATTEMPTS=600

owner_uid=${RATASH_OWNER_UID:-}
if [ -z "$owner_uid" ]; then
    owner_uid=$(/usr/bin/stat -f '%u' /dev/console)
fi
case "$owner_uid" in
    ''|*[!0-9]*)
        echo 'Ratash requires a numeric RATASH_OWNER_UID.' >&2
        exit 1
        ;;
esac
if [ "$owner_uid" -eq 0 ]; then
    echo 'Ratash must be assigned to a non-root local user.' >&2
    exit 1
fi

/bin/chmod 0755 "$CLI_EXECUTABLE" "$SERVICE_EXECUTABLE" "$SERVICE_ROOT/bin/mihomo"
/usr/sbin/chown root:wheel "$CLI_EXECUTABLE" "$SERVICE_EXECUTABLE" "$SERVICE_ROOT/bin/mihomo"
/bin/chmod 0755 "$SERVICE_ROOT/share" "$GEODATA_ROOT"
/usr/sbin/chown root:wheel "$SERVICE_ROOT/share" "$GEODATA_ROOT"
/bin/chmod 0644 "$GEODATA_ROOT/ASN.mmdb" "$GEODATA_ROOT/Country.mmdb" "$GEODATA_ROOT/GeoIP.dat" "$GEODATA_ROOT/GeoSite.dat"
/usr/sbin/chown root:wheel "$GEODATA_ROOT/ASN.mmdb" "$GEODATA_ROOT/Country.mmdb" "$GEODATA_ROOT/GeoIP.dat" "$GEODATA_ROOT/GeoSite.dat"
/bin/chmod 0644 "$SERVICE_PLIST"
/usr/sbin/chown root:wheel "$SERVICE_PLIST"
/usr/bin/sed -i '' "s/@OWNER_UID@/$owner_uid/g" "$SERVICE_PLIST"
/usr/bin/plutil -lint "$SERVICE_PLIST" >/dev/null

/bin/launchctl bootout "system/$SERVICE_LABEL" >/dev/null 2>&1 || true
attempt=0
while /bin/launchctl print "system/$SERVICE_LABEL" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge "$SERVICE_REMOVAL_ATTEMPTS" ]; then
        echo 'Ratash timed out waiting for the previous Core service to stop.' >&2
        exit 1
    fi
    /bin/sleep 0.1
done
/bin/launchctl bootstrap system "$SERVICE_PLIST"
/bin/launchctl enable "system/$SERVICE_LABEL"
/bin/launchctl kickstart -k "system/$SERVICE_LABEL"

exit 0
