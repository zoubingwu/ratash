#compdef ratash

autoload -U is-at-least

_ratash() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_ratash_commands" \
"*::: :->ratash" \
&& ret=0
    case $state in
    (ratash)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ratash-command-$line[1]:"
        case $line[1] in
            (start)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(stop)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(restart)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(profile)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_ratash__subcmd__profile_commands" \
"*::: :->profile" \
&& ret=0

    case $state in
    (profile)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ratash-profile-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
':subscription_url -- HTTP(S) subscription URL:_default' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(use)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
':profile -- Opaque Profile ID or unique case-sensitive display name:_default' \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
':profile -- Opaque Profile ID or unique case-sensitive display name:_default' \
&& ret=0
;;
        esac
    ;;
esac
;;
(proxy)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_ratash__subcmd__proxy_commands" \
"*::: :->proxy" \
&& ret=0

    case $state in
    (proxy)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ratash-proxy-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
':group -- Opaque Proxy Group ID or unique case-sensitive display name:_default' \
&& ret=0
;;
(select)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
':group -- Opaque Proxy Group ID or unique case-sensitive display name:_default' \
':node -- Source-aware Node ID or unique case-sensitive display name:_default' \
&& ret=0
;;
        esac
    ;;
esac
;;
(latency)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_ratash__subcmd__latency_commands" \
"*::: :->latency" \
&& ret=0

    case $state in
    (latency)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ratash-latency-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
':node -- Source-aware Node ID or unique case-sensitive display name:_default' \
&& ret=0
;;
        esac
    ;;
esac
;;
(rule)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_ratash__subcmd__rule_commands" \
"*::: :->rule" \
&& ret=0

    case $state in
    (rule)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ratash-rule-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(add)
_arguments "${_arguments_options[@]}" : \
'--before=[Insert before this exact, complete Rule String]:BEFORE:_default' \
'--after=[Insert after this exact, complete Rule String]:AFTER:_default' \
'--prepend[Insert before every existing rule]' \
'--append[Insert after every existing rule]' \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
':rule -- Complete, case-sensitive Mihomo Rule String to insert:_default' \
&& ret=0
;;
(replace)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
':old_rule -- Exact, complete Rule String to replace:_default' \
':new_rule -- Complete Rule String to insert in its place:_default' \
&& ret=0
;;
(remove)
_arguments "${_arguments_options[@]}" : \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
':rule -- Exact, complete Rule String to remove:_default' \
&& ret=0
;;
        esac
    ;;
esac
;;
(logs)
_arguments "${_arguments_options[@]}" : \
'--follow[Continue streaming until interrupted]' \
'--json[Emit a versioned JSON document or NDJSON stream]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'::topic -- Optional audience-specific help topic:((agent\:"Stable operation guidance for AI Agents and scripts"))' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_ratash_commands] )) ||
_ratash_commands() {
    local commands; commands=(
'start:Start the background Supervisor and wait until it is ready' \
'stop:Stop the Supervisor and its Managed Core' \
'restart:Restart the Supervisor and restore its committed runtime' \
'status:Open the Status Interface or print one JSON status snapshot' \
'profile:Add, list, activate, and remove subscription Profiles' \
'proxy:List Proxy Groups and select Nodes' \
'latency:Inspect latency for Active Profile Nodes' \
'rule:List and atomically mutate the Local Rule Set' \
'logs:Follow the live Core Log stream' \
'help:Show command help or the AI Agent operation contract' \
    )
    _describe -t commands 'ratash commands' commands "$@"
}
